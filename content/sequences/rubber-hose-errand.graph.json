{
  "vars": {
    "squashIn": "smoothstep(0, 3, t)",
    "walkT": "smoothstep(3, 12, t)",
    "hatT": "smoothstep(12, 18, t)",
    "hopT": "smoothstep(18, 24, t)",
    "exitT": "smoothstep(24, 31, t)",
    "x": "-0.85 + (0.65 - 0.28 + 0.85) * walkT + 2.1 * exitT",
    "hop": "abs(sin((t - 18) * 8)) * 0.28 * hopT * (1 - exitT)",
    "bodyY": "2.2 * (1 - squashIn) + 0.55 * squashIn + hop",
    "squash": "1 + 0.35 * sin(squashIn * pi) * (1 - squashIn)",
    "stride": "walkT > 0 && hatT < 1 && exitT < 0.2 ? t * 7 : hopT * t * 9",
    "leg": "sin(stride) * 0.55 * max(walkT, hopT) * (1 - hatT * 0.4)",
    "arm": "sin(stride + pi) * 0.7"
  },
  "camera": {
    "type": "locked",
    "eye": [0, 1.2, 3.55],
    "target": [0, 0.72, 0],
    "fov": 48,
    "near": 0.1,
    "far": 30
  },
