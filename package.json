{
  "name": "weeks-on-fire-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "codegen": "tsx scripts/content-index/index.ts",
    "codegen:check": "tsx scripts/content-index/index.ts --check",
    "agent-docs": "tsx scripts/content-index/emit-agent-docs.ts",
    "agent-docs:check": "tsx scripts/content-index/emit-agent-docs.ts --check",
    "migrate:content": "tsx scripts/content-index/migrate-from-ts.ts",
    "dev": "vite",
    "lint": "eslint src scripts --max-warnings 0",
    "format": "prettier --check src scripts",
    "format:write": "prettier --write src scripts",
    "build": "npm run codegen && npm run agent-docs && tsc -b && vite build --base ${VITE_BASE:-./} && tsx scripts/check-index-encoding.ts && tsx scripts/emit-link-index.ts && cp dist/index.html dist/404.html",
    "build:check": "npm run build && tsx scripts/check-bundle-size.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@vitejs/plugin-react": "6.2.1",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
