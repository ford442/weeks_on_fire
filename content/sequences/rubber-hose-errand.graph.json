    "lightDir": [0.2, 0.75, 0.7],
    "lightColor": [1.05, 0.98, 0.88],
    "ambient": [0.46, 0.4, 0.34],
    "fogDensity": 0,
    "pointLight": {"position": [0.1, 1.6, 2.4], "color": [1, 0.9, 0.75], "range": 7}
  },
  "nodes": [
