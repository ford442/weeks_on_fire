      "visible": "exitT <= 0.85",
      "vars": {"lift": "1 - 0.45 * hatT"},
      "translation": ["0.85 + (x - 0.85) * hatT", "0.22 + (bodyY + 0.62 - 0.22) * hatT", 0],
      "rotation": ["deg(hatT * 0.4)", "deg(hatT * 1.2)", 0],
