{
  "vars": {
    "squashIn": "smoothstep(0, 2, t)",
    "run": "t >= 2 && t < 12",
    "skidT": "smoothstep(12, 14.5, t)",
    "hold": "smoothstep(14.5, 16, t)",
    "runTime": "max(0, min(t - 2, 10))",
    "skidElapsed": "max(0, min(t - 12, 2.5))",
    "scroll": "runTime * 3.6 + 3.6 * (skidElapsed - (skidElapsed * skidElapsed) / (2 * 2.5))",
    "x": "-0.15 + 0.35 * (1 - squashIn)",
    "hop": "run ? abs(sin(t * 16)) * 0.06 : 0",
    "lean": "run ? -0.35 : 0.55 * skidT * (1 - hold)",
    "squashY": "0.7 + 0.3 * squashIn - 0.22 * skidT + hop",
    "bodyY": "2.1 * (1 - squashIn) + 0.55 * squashIn + hop - 0.08 * skidT",
    "stride": "run ? t * 16 : 12 * 16 * (1 - skidT)"
  },
