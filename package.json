{
  "name": "weeks-on-fire-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "codegen": "tsx scripts/content-index/index.ts",
    "codegen:check": "tsx scripts/content-index/index.ts --check",
    "agent-docs": "tsx scripts/content-index/emit-agent-docs.ts",
    "agent-docs:check": "tsx scripts/content-index/emit-agent-docs.ts --check",
    "migrate:content": "tsx scripts/content-index/migrate-from-ts.ts",
    "dev": "vite",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --check src",
    "format:write": "prettier --write src",
    "build": "npm run codegen && npm run agent-docs && tsc -b && vite build && node scripts/check-index-encoding.mjs && cp dist/index.html dist/404.html",
    "build:check": "npm run build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.3",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "postcss": "8.5.15",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.0.16",
    "zod": "4.5.2"
  }
}
